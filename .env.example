# Continuum — Community Edition
# Copy this file to .env. Never commit .env or real provider keys.

# Local-only development auth. This is safe only because the default Compose
# ports bind to 127.0.0.1. Public deployments must set this to false and use
# strong, unique values for every secret below.
MEMORYOS_ALLOW_OPEN=true
MEMORYOS_API_KEYS=sk_mem_community:user_demo
MEMORYOS_SSE_SECRET=community-only-change-me
SESSION_SECRET=community-session-secret-change-me

# Creates one local workspace/key automatically on first boot. Keep true only
# for the loopback Community Edition; public deployments must set it false.
COMMUNITY_MODE=true
COMMUNITY_API_KEY=sk_mem_community
COMMUNITY_ACCOUNT_ID=community_local

# One provider is enough for background memory extraction. Leave both blank
# if you only want to inspect the API and health endpoints.
SARVAM_API_KEY=
GEMINI_API_KEY=

# Optional research providers used only by the Memento/Smara layer.
SERPER_API_KEY=
EXA_API_KEY=

# Keep the browser console on the local machine.
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata

# Neo4j credentials for the local compose service.
NEO4J_PASSWORD=community-change-me
POSTGRES_PASSWORD=community-postgres

# Optional published images. Leave these at their defaults for the normal
# release path; setting them is useful when testing a private image mirror.
SYNTARUS_BACKEND_IMAGE=ghcr.io/syntarus12/continuum-backend:latest
SYNTARUS_CONSOLE_IMAGE=ghcr.io/syntarus12/continuum-console:latest

# Local ports. These are loopback-only in docker-compose.yml.
API_PORT=8000
CONSOLE_PORT=5173
