# Syntarus Memory Engine — Community Edition
# Copy this file to .env. Never commit .env or real provider keys.

# Local-only development auth. Use a scoped key and set this to false before
# putting the service on a shared network.
MEMORYOS_ALLOW_OPEN=true
MEMORYOS_API_KEYS=sk_mem_community:user_demo
MEMORYOS_SSE_SECRET=community-only-change-me

# One provider is enough for background memory extraction. Leave both blank
# if you only want to inspect the API and health endpoints.
SARVAM_API_KEY=
GEMINI_API_KEY=

# Optional research providers used only by the Memento/Smara layer.
SERPER_API_KEY=
EXA_API_KEY=

# Keep the browser console on the local machine.
CORS_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata

# Neo4j credentials for the local compose service.
NEO4J_PASSWORD=community-change-me

